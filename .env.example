# GoodsWarehouse environment (SPEC §11). Copy to .env and export, or set in systemd unit.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WAREHOUSE_ADDRESS=
WAREHOUSE_HOURS=
WAREHOUSE_PHONE=
FREE_STORAGE_DAYS=7
CALL_AFTER_DAYS=3
WAREHOUSE_BLOCK_CAPACITY=400
WAREHOUSE_CITY=Владивосток
# Автопилот (demo simulator): defaults to DEBUG; set false in production.
AUTOPILOT_ENABLED=true
# Only for seed_demo: password of demo users manager/sklad (default demo12345).
# DEMO_PASSWORD=
